{
  "name": "opencode-supermemory",
  "version": "2.0.5",
  "description": "OpenCode plugin that gives coding agents persistent memory using Supermemory",
  "type": "module",
  "main": "./dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "opencode-supermemory": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsdown",
    "build:bun": "bun build ./src/index.ts --outdir ./dist --target node && bun build ./cli/index.ts --outfile ./dist/cli.js --target node && tsc --emitDeclarationOnly",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "check": "biome check --write",
    "format": "biome format --write",
    "lint": "biome lint --write"
  },
  "keywords": [
    "opencode",
    "plugin",
    "supermemory",
    "memory",
    "ai",
    "coding-agent"
  ],
  "author": "Supermemory",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/supermemoryai/opencode-supermemory"
  },
  "dependencies": {
    "@opencode-ai/plugin": "^1.0.162",
    "citty": "^0.2.2",
    "supermemory": "^4.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@types/bun": "latest",
    "tsdown": "^0.22.0",
    "typescript": "^5.7.3"
  },
  "opencode": {
    "type": "plugin",
    "hooks": [
      "chat.message",
      "event"
    ]
  },
  "files": [
    "dist"
  ]
}
